# ── Core Providers ───────────────────────────────────────────
ASR_SERVER=faster-whisper
LLM_SERVER=ollama
TTS_SERVER=piper

# ── Ollama LLM ───────────────────────────────────────────────
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
# Set to true to auto-start Ollama when the chatbot starts
SERVE_OLLAMA=true
# Max tokens to predict (0 = unlimited)
# OLLAMA_PREDICT_NUM=128

# ── Faster Whisper ASR ───────────────────────────────────────
FASTER_WHISPER_HOST=localhost
FASTER_WHISPER_PORT=8803
FASTER_WHISPER_REQUEST_TYPE=base64
# Model size: tiny, base, small, medium, large — or a local path
FASTER_WHISPER_MODEL_SIZE_OR_PATH=tiny
FASTER_WHISPER_LANGUAGE=en

# ── Piper TTS ────────────────────────────────────────────────
PIPER_BINARY_PATH=/home/pi/.local/bin/piper
PIPER_MODEL_PATH=/home/pi/solarbot/voices/en_US-amy-medium.onnx

# ── RAG (Retrieval-Augmented Generation) ─────────────────────
ENABLE_RAG=true
EMBEDDING_SERVER=ollama
OLLAMA_EMBEDDING_ENDPOINT=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
VECTOR_DB_SERVER=qdrant
QDRANT_HOST=http://localhost:6333
RAG_KNOWLEDGE_SCORE_THRESHOLD=0.8
# Summarize each knowledge chunk with LLM before indexing (slower, more accurate)
ENABLE_KNOWLEDGE_SUMMARY=ollama
RAG_KNOWLEDGE_SUMMARY_PROMPT_PREFIX="Please provide a concise summary for the following text in 30 words or less:"

# ── System Prompt ────────────────────────────────────────────
SYSTEM_PROMPT="You are solar bot, a feminist AI assistant for a project knowledge base. Answer in short 1-2 sentences only. Use an intersectional feminist lens: prioritize power, care, justice, lived experience. Use RAG context when available."

# ── Display ──────────────────────────────────────────────────
DEFAULT_EMOJI=🌞

# ── Chat History ─────────────────────────────────────────────
# Reset chat history after this many seconds of inactivity (default: 300)
# CHAT_HISTORY_RESET_TIME=300

# ── Wake Word (optional) ─────────────────────────────────────
# WAKE_WORD_ENABLED=true
# WAKE_WORDS=hey_jarvis
# WAKE_WORD_THRESHOLD=0.5
# WAKE_WORD_COOLDOWN_SEC=1.5
# WAKE_WORD_IDLE_TIMEOUT_SEC=60

# ── Web Display (dev only, no physical hardware needed) ──────
# WHISPLAY_WEB_ENABLED=true
# WHISPLAY_WEB_PORT=17880
# WHISPLAY_WEB_HOST=0.0.0.0
# WEB_AUDIO_ENABLED=true
# WEB_CAMERA_ENABLED=true

# ── Proxy (if needed to reach the internet) ──────────────────
# HTTPS_PROXY=https://your_proxy
